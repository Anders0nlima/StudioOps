# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# n8n Webhook Endpoints (Orquestração de Agentes)
NEXT_PUBLIC_N8N_RESEARCH_WEBHOOK_URL=http://localhost:5678/webhook/pesquisar-ideias
NEXT_PUBLIC_N8N_GENERATE_WEBHOOK_URL=http://localhost:5678/webhook/gerar-roteiro
NEXT_PUBLIC_N8N_PUBLISH_WEBHOOK_URL=http://localhost:5678/webhook/publicar
